# Copy to backend/.env. Never commit real values. Production values live only on the server (chmod 600).

# --- process ---
APP_ENV=development                 # production enables the strict checks below
APP_URL=http://localhost:5173       # public origin; cookies, links in emails and the CSRF origin check use it
PORT=4000
LOG_LEVEL=info

# --- database ---
# Production: RDS PostgreSQL in ap-south-1, private, reachable only from the EC2 security group.
#   DATABASE_URL=postgresql://stash_app:<password>@stash-db.cv4i600y6bxd.ap-south-1.rds.amazonaws.com:5432/stash?sslmode=require
# Development: local Postgres or Neon.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require           # direct endpoint (app + migrations)
# DATABASE_URL_DIRECT=                                                # optional: migrations only
DB_POOL_SIZE=20

# --- auth ---
JWT_SECRET=                         # 32+ random chars: python -c 'import secrets;print(secrets.token_urlsafe(48))'
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- email (SES SMTP). Empty in development: emails print to the API log. Required in production. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Stash <no-reply@example.com>
# Check mail end to end with: python -m app.mail_check you@example.com

# --- save by email (optional). Mail to save+<token>@INBOUND_EMAIL_DOMAIN reaches /api/v1/inbound/email through
# deploy/inbound-email-worker.js, which sends INBOUND_SECRET. Leave empty to turn the feature off. ---
INBOUND_EMAIL_DOMAIN=
INBOUND_SECRET=

# --- AI ---
OPENAI_API_KEY=                     # Bedrock Mantle key
OPENAI_BASE_URL=                    # Mantle OpenAI-compatible endpoint
CHAT_MODEL=zai.glm-5
VOYAGER_API_KEY=
EMBED_MODEL=voyage-4
RERANK_MODEL=rerank-3-lite
AI_ENABLED=true
AI_MONTHLY_TOKEN_BUDGET=300000
CHAT_REQUESTS_PER_HOUR=30

# --- content safety: word list + moderator model (text) and vision model (images), via the AI key above ---
SAFETY_REQUIRED=true                # false only in local development; production refuses to start without it

# --- image uploads ---
S3_BUCKET=                          # empty in development: files go to LOCAL_UPLOAD_DIR
AWS_REGION=ap-south-1
# AWS_ENDPOINT_URL_S3=              # S3-compatible storage only; leave unset on EC2 (instance role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
UPLOAD_MAX_BYTES=10485760
USER_STORAGE_QUOTA_MB=500
LOCAL_UPLOAD_DIR=.uploads
